{
  "name": "@reto18/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/main.js",
    "start": "node dist/main.js",
    "sembrar:admin": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/identidad/sembrar-admin.cli.js",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.json && vitest run",
    "test:int": "vitest run --config vitest.integracion.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@reto18/shared": "workspace:*",
    "@supabase/supabase-js": "2.117.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
