# Copia este archivo como `.env` en la raíz del repo para trabajar en local.
# `.env` está ignorado por Git: nunca subas claves reales.

# ---------------------------------------------------------------
# API (apps/api). En producción se cargan en el servicio de Railway.
# ---------------------------------------------------------------

# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co
# Supabase > Project Settings > API > service_role (secreta: solo la API, nunca la web)
SUPABASE_SERVICE_ROLE_KEY=
# Puerto de la API. En local, 3001. Railway lo asigna solo: no lo cargues allí.
PORT=3001
# Origen(es) de la web permitidos por CORS, separados por coma.
# Local: http://localhost:3000 · Railway: la URL de Vercel (https://<proyecto>.vercel.app)
WEB_URL=http://localhost:3000

# Cuenta de administrador que crea `pnpm --filter @reto18/api sembrar:admin` (idempotente).
# Solo las usa el script, en local; no hace falta cargarlas en Railway. Nunca subas valores reales.
ADMIN_CORREO=
# Mínimo 8 caracteres.
ADMIN_CONTRASENA=
# 9 dígitos peruanos (se guarda como +51…) o E.164 completo (+…).
ADMIN_WHATSAPP=

# IA (módulo `ia`, AD-11): Ollama en el PC de Jean Pierre, alcanzado por un túnel.
# Si faltan o Ollama no responde, la API usa textos y campaña de respaldo (nunca falla por la IA).
# URL base de Ollama, sin `/api`. Local: http://localhost:11434 · Railway: la URL del túnel (Cloudflare Tunnel o ngrok)
OLLAMA_URL=
# Modelo instalado en Ollama (`ollama list`). Lo elige Jean Pierre; debe escribir bien en español.
OLLAMA_MODELO=
# Tiempo límite de cada llamada a la IA, en milisegundos. Por defecto, 30000.
IA_TIEMPO_LIMITE_MS=30000

# ---------------------------------------------------------------
# Web (apps/web). En producción se carga en el proyecto de Vercel.
# ---------------------------------------------------------------

# URL base de la API, sin `/api/v1`. Local: http://localhost:3001 · Vercel: la URL de Railway
API_URL=http://localhost:3001

# Supabase solo para iniciar sesión (AD-1). Son públicas: llegan al navegador.
# Supabase > Project Settings > API > Project URL. Si se deja vacía, en local se usa SUPABASE_URL.
# Local (`pnpm db:start`): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
# Supabase > Project Settings > API > anon / publishable (pública). Local: la "anon key" de `supabase status`.
# Nunca pongas aquí la service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
